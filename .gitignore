# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------- NATCO
# Firebase client configuration is supplied per environment at build time and
# is never committed. Nothing here is a secret in the cryptographic sense —
# the security boundary is firebase/firestore.rules — but keeping project
# identifiers out of the repository stops a developer build from writing to
# production by accident.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart
lib/firebase_options_*.dart

# Service-account credentials must never enter the mobile project
# (requirement section 34). This pattern is a backstop, not a policy.
*service-account*.json
*serviceAccount*.json
*-adminsdk-*.json

# Local environment overrides
.env
.env.*
!.env.example

# OMR accuracy dataset: real photographs, large binaries. Kept outside the
# repository (see docs/10-omr-calibration-testing.md).
omr_dataset/images/
omr_dataset/reports/
